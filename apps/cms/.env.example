# Local development only. Copy to .env and replace every placeholder.
POSTGRES_PASSWORD=<local-bootstrap-password>
APP_DB=<development-database-name>
APP_USER=<development-application-user>
APP_PASSWORD=<local-application-password>
DATABASE_URL=postgresql://<development-application-user>:<local-application-password>@127.0.0.1:55432/<development-database-name>
PAYLOAD_SECRET=<local-payload-secret>
